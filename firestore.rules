rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /app_config/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.enabled == true;
      allow write: if false;
    }

    match /users/{uid} {
      allow get: if owns(uid) || (signedIn() && resource.data.profilePublic == true);
      allow list: if signedIn()
        && resource.data.profilePublic == true
        && request.query.limit <= 100;
      allow create: if owns(uid);
      allow update, delete: if owns(uid);

      match /pets/{petId} {
        allow read: if owns(uid) || (
          signedIn()
          && get(/databases/$(database)/documents/users/$(uid)).data.profilePublic == true
          && get(/databases/$(database)/documents/users/$(uid)).data.petsPublic == true
          && resource.data.isPublic == true
        );
        allow write: if owns(uid);
      }

      match /private_profile/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_pets/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_weights/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_health/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_checklists/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_notifications/{documentId} {
        allow read, write: if owns(uid);
      }

      match /private_state/{documentId} {
        allow read, write: if owns(uid);
      }
    }

    match /friend_requests/{requestId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if signedIn()
        && request.auth.uid in resource.data.participants;
    }

    match /fcm_tokens/{tokenId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
